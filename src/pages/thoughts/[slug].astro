---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import ArticleView from '../../components/content/ArticleView.astro'
import ShellLayout from '../../layouts/ShellLayout.astro'
import { getThoughts, minutes, neighbours } from '../../lib/content'
import { openCmd } from '../../shell/listings'

export const getStaticPaths = (async () => {
  const thoughts = await getThoughts()
  return thoughts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ...neighbours(thoughts, entry.id) },
  }))
}) satisfies GetStaticPaths

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const cmd = openCmd({ section: 'thoughts', slug: entry.id })
const suggestions = [
  prev && { label: '← prev', cmd: openCmd({ section: 'thoughts', slug: prev.id }) },
  next && { label: 'next →', cmd: openCmd({ section: 'thoughts', slug: next.id }) },
  { label: 'ls thoughts', cmd: 'ls thoughts' },
].filter((s) => !!s)
---

<ShellLayout title={entry.data.title} description={entry.data.description} cmd={cmd} next={suggestions}>
  <ArticleView
    title={entry.data.title}
    section="thoughts"
    date={entry.data.pubDate}
    minutes={minutes(entry)}
    tags={entry.data.tags}
  >
    <Content />
  </ArticleView>
</ShellLayout>
