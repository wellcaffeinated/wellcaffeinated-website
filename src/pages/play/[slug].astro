---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import ToyFrame from '../../components/content/ToyFrame.astro'
import ShellLayout from '../../layouts/ShellLayout.astro'
import { getToys, neighbours } from '../../lib/content'
import { openCmd } from '../../shell/listings'

export const getStaticPaths = (async () => {
  const toys = await getToys()
  return toys.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ...neighbours(toys, entry.id) },
  }))
}) satisfies GetStaticPaths

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const cmd = openCmd({ section: 'play', slug: entry.id })
const suggestions = [
  prev && { label: '← prev', cmd: openCmd({ section: 'play', slug: prev.id }) },
  next && { label: 'next →', cmd: openCmd({ section: 'play', slug: next.id }) },
  { label: 'ls play', cmd: 'ls play' },
].filter((s) => !!s)
---

<ShellLayout title={entry.data.title} description={entry.data.description} cmd={cmd} status={entry.data.status} next={suggestions}>
  <ToyFrame toy={entry}>
    <Content />
  </ToyFrame>
</ShellLayout>
