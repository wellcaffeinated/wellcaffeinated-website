---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import ProjectView from '../../components/content/ProjectView.astro'
import ShellLayout from '../../layouts/ShellLayout.astro'
import { getProjects, neighbours } from '../../lib/content'
import { openCmd } from '../../shell/listings'

export const getStaticPaths = (async () => {
  const projects = await getProjects()
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, ...neighbours(projects, entry.id) },
  }))
}) satisfies GetStaticPaths

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const cmd = openCmd({ section: 'projects', slug: entry.id })
const suggestions = [
  prev && { label: '← prev', cmd: openCmd({ section: 'projects', slug: prev.id }) },
  next && { label: 'next →', cmd: openCmd({ section: 'projects', slug: next.id }) },
  { label: 'ls projects', cmd: 'ls projects' },
].filter((s) => !!s)
---

<ShellLayout title={entry.data.title} description={entry.data.description} cmd={cmd} next={suggestions}>
  <ProjectView project={entry}>
    <Content />
  </ProjectView>
</ShellLayout>
