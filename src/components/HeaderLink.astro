---
// A nav link that marks itself active on the current route. Demonstrates:
// extending native element attributes, spreading `...rest` props, the
// `class:list` directive, `Astro.url`, a `<slot />`, and scoped styles.
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...rest } = Astro.props

const stripSlash = (path: string) => path.replace(/\/+$/, '') || '/'
const isActive = stripSlash(href?.toString() ?? '/') === stripSlash(Astro.url.pathname)
---

<a href={href} class:list={[className, { active: isActive }]} {...rest}>
  <slot />
</a>

<style>
  a {
    text-decoration: none;
  }
  a.active {
    font-weight: bold;
    text-decoration: underline;
  }
</style>
