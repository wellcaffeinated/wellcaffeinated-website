---
// Frame, not skin: a toy owns everything between the bars and paints in its
// own style. The script below mounts content/play/<slug>/toy.ts if there is
// one; until then the frame is a labelled slot.
import type { Toy } from '../../lib/content'
import type { ToyConstants } from '../../lib/toy'

interface Props {
  toy: Toy
}

const { toy } = Astro.props
const { title, description, color, ink, constants } = toy.data
const constantsByName: ToyConstants = Object.fromEntries(
  constants.map((constant) => [constant.name, constant.value]),
)
---

<main
  class="frame"
  style={`--toy-bg:${color ?? 'var(--panel)'};--toy-ink:${ink ?? 'var(--fg)'}`}
  data-toy={toy.id}
  data-constants={JSON.stringify(constantsByName)}
>
  <div class="mount" data-toy-mount></div>
  <div class="note" data-toy-note>
    <strong>{title}</strong> · toy mounts here (its own canvas / framework). {description}
  </div>
  {
    constants.length > 0 && (
      <dl class="constants">
        <dt>constants · also "set &lt;name&gt; &lt;value&gt;"</dt>
        {constants.map((k) => (
          <dd>
            {k.name} <span class="value">{k.value}</span> <span class="unit">{k.unit}</span>
          </dd>
        ))}
      </dl>
    )
  }
  <div class="notes prose">
    <slot />
  </div>
</main>

<script>
  import { loadToy, type ToyConstants } from '../../lib/toy'

  async function mountToy(frame: HTMLElement) {
    const slug = frame.dataset.toy ?? ''
    const el = frame.querySelector<HTMLElement>('[data-toy-mount]')
    const loading = loadToy(slug)
    if (!el || !loading) return
    const constants: ToyConstants = JSON.parse(frame.dataset.constants ?? '{}')
    const toy = await loading
    toy.mount({ el, constants })
    const note = frame.querySelector<HTMLElement>('[data-toy-note]')
    if (note) note.hidden = true
  }

  const frame = document.querySelector<HTMLElement>('[data-toy]')
  if (frame) mountToy(frame)
</script>

<style>
  .frame {
    flex: 1;
    position: relative;
    min-height: calc(100dvh - var(--bar-h) - 52px);
    background: var(--toy-bg);
    color: var(--toy-ink);
    background-image: radial-gradient(rgb(0 0 0 / 0.1) 1px, transparent 1px);
    background-size: 18px 18px;
    animation: rise var(--rise) both;
  }
  .mount {
    position: absolute;
    inset: 0;
  }
  .note {
    position: absolute;
    left: 16px;
    top: 14px;
    max-width: 60%;
    font-size: var(--text-xs);
    opacity: 0.7;
  }
  .constants {
    position: absolute;
    right: 14px;
    top: 12px;
    margin: 0;
    padding: 8px 12px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.7);
    color: #1a1a1a;
    backdrop-filter: blur(4px);
    font-size: var(--text-xs);
    line-height: 1.7;
  }
  dt {
    font-size: 10px;
    color: #666;
  }
  dd {
    margin: 0;
  }
  .value {
    color: #5b3fae;
  }
  .unit {
    color: #999;
  }
  .notes {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    max-width: 480px;
    font-size: var(--text-sm);
    opacity: 0.8;
  }
</style>
