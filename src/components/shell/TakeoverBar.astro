---
// Bottom bar on content pages: a sleeping prompt with contextual suggestions.
import { hrefFor } from '../../shell/router'

export interface Suggestion {
  label: string
  cmd: string
}

interface Props {
  next?: Suggestion[]
}

const { next = [] } = Astro.props
---

<div class="takeover-bar">
  <a href="/" class="pill" data-strong data-back>↩ back</a>
  {next.map((n) => <a href={hrefFor(n.cmd)} class="pill" data-cmd={n.cmd}>{n.label}</a>)}
  <span class="note"><span class="dollar">$</span> esc returns to the log</span>
</div>

<style>
  .takeover-bar {
    position: sticky;
    bottom: 0;
    z-index: 20;
    height: 52px;
    background: var(--bar);
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: var(--gap);
    padding: 0 12px;
    font-size: var(--text-xs);
    color: var(--muted);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .note {
    margin-left: auto;
    flex: none;
    white-space: nowrap;
  }
  .dollar {
    color: var(--accent);
  }
</style>
