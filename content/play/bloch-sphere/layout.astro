---
// This toy's own layout. It writes the skeleton — a full-bleed sphere, a live
// readout, a row of gate keys — and toy.ts drives it through the data-*
// vocabulary below, which nothing outside this folder reads:
//
//   [data-lab]                 the root the toy searches from
//   [data-toy-mount]           where the sphere is drawn
//   [data-readout="theta"|"phi"]  text the toy keeps current
//   [data-gate="h"|"x"|"y"|"z"|"s"]  apply that gate
//   [data-action="play"|"step"|"reset"]  transport
//   [data-playing="true"|"false"]  on the root; swaps the play/pause label
//
// The toy works without any of it (the built-in stage layout gives it only a
// box), so removing this file costs the controls, not the toy.
import type { ToyLayoutProps } from '@lib/toy'

type Props = ToyLayoutProps

const GATE_KEYS = [
  { gate: 'h', label: 'H', title: 'Hadamard' },
  { gate: 'x', label: 'X', title: 'Pauli X' },
  { gate: 'y', label: 'Y', title: 'Pauli Y' },
  { gate: 'z', label: 'Z', title: 'Pauli Z' },
  { gate: 's', label: 'R', title: 'phase rotation, by the phase constant' },
]

const { toy } = Astro.props
const { constants } = toy.data
---

<div class="lab" data-lab data-playing="true">
  <div class="sphere" data-toy-mount></div>

  <dl class="readout">
    <div><dt>θ</dt><dd data-readout="theta">—</dd></div>
    <div><dt>φ</dt><dd data-readout="phi">—</dd></div>
    {
      constants.map((k) => (
        <div class="constant">
          <dt>{k.name}</dt>
          <dd>{k.value}<span class="unit">{k.unit}</span></dd>
        </div>
      ))
    }
  </dl>

  <div class="notes prose"><slot /></div>

  <div class="controls">
    <div class="group">
      <span class="caption">gates</span>
      {GATE_KEYS.map((k) => <button class="key" type="button" data-gate={k.gate} title={k.title}>{k.label}</button>)}
    </div>
    <div class="group">
      <span class="caption">loop</span>
      <button class="key wide" type="button" data-action="play">
        <span class="playing">pause</span><span class="paused">play</span>
      </button>
      <button class="key wide" type="button" data-action="step">step →</button>
      <button class="key wide" type="button" data-action="reset">↺ reset</button>
    </div>
  </div>
</div>

<style>
  .lab {
    position: relative;
    flex: 1;
    min-height: calc(100dvh - var(--bar-h) - 52px);
    background: var(--toy-bg);
    color: var(--toy-ink);
    animation: rise var(--rise) both;
  }
  .sphere {
    position: absolute;
    inset: 0;
  }

  .readout,
  .notes,
  .controls {
    position: absolute;
  }

  .readout {
    right: 16px;
    top: 14px;
    margin: 0;
    display: grid;
    gap: 2px;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
  .readout > div {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }
  .readout dt {
    opacity: 0.55;
  }
  .readout dd {
    margin: 0;
    min-width: 62px;
    text-align: right;
  }
  .constant {
    opacity: 0.55;
  }
  .unit {
    opacity: 0.6;
    padding-left: 2px;
  }

  .notes {
    left: 16px;
    top: 14px;
    max-width: min(360px, calc(100% - 32px));
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  .controls {
    left: 50%;
    transform: translateX(-50%);
    bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 18px;
    max-width: calc(100% - 32px);
  }
  .group {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .caption {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.45;
    padding-right: 2px;
  }
  .key {
    font: inherit;
    font-size: var(--text-xs);
    color: inherit;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: var(--radius-sm);
    padding: 7px 11px;
    min-width: 34px;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.12s,
      border-color 0.12s;
  }
  .key:hover {
    background: color-mix(in srgb, currentColor 16%, transparent);
    border-color: currentColor;
  }
  .key:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .wide {
    letter-spacing: 0.02em;
  }

  /* The toy owns the state; the layout owns which label it shows. */
  [data-playing='true'] .paused,
  [data-playing='false'] .playing {
    display: none;
  }

  @media (max-width: 620px) {
    .notes {
      display: none;
    }
    .controls {
      gap: 10px;
    }
  }
</style>
